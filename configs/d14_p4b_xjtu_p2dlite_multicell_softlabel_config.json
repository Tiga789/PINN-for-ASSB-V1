    "xjtu_d14_p3b_batch56_replay_smoke"
  ],
  "skip_scan_fragments": [
    "xjtu_softlabels",
    "xjtu_d14_p4",
    "xjtu_d14_p4a",
    "xjtu_d14_p4b",
    "EvalFin",
    "ModelFin",
    "__pycache__"
