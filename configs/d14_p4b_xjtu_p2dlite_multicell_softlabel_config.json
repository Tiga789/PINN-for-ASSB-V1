  "output_dir": "E:/XJTU battery dataset/_gv1_cache/xjtu_softlabels_p2dlite_v1_p4b_multicell_v3",
  "selection": {
    "mode": "balanced_by_batch_with_required_batches",
    "counts_by_batch": {
      "Batch-1": 2,
      "Batch-3": 2,
      "Batch-4": 2,
      "Batch-5": 1,
      "Batch-6": 1
    },
    "required_min_by_batch": {
      "Batch-1": 2,
      "Batch-3": 2,
      "Batch-4": 2
    },
    "optional_batches": [
      "Batch-5",
      "Batch-6"
    ],
    "exclude_exact_outliers": [
