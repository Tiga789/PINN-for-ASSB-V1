    "max_theta_out_of_bounds_fraction_warn": 0.02,
    "max_theta_out_of_bounds_fraction_fail": 0.1,
    "voltage_upper_warn_V": 4.25,
    "voltage_upper_fail_V": 4.35,
    "voltage_lower_warn_V": 2.45,
    "voltage_lower_fail_V": 2.35,
    "metadata_required": true,
    "required_npz_keys": [
      "t_global_s",
      "I_profile",
      "voltage_exp",
      "temperature_C",
      "cycle_id",
      "step_id",
      "step_type",
      "r_a",
      "r_c",
      "cs_a",
      "cs_c",
      "theta_a",
      "theta_c",
      "phie",
      "phis_c",
      "phis_c_base",
      "phis_c_soft",
      "phis_c_soft_raw",
      "voltage_bound_correction",
      "cbar_a",
      "cbar_c",
      "Uocp_a",
      "Uocp_c",
      "eta_a",
      "eta_c",
      "j_a",
      "j_c",
      "voltage_residual_s1k",
      "low_transition_weight",
      "batch",
      "protocol",
      "cell_uid",
      "resolved_spec_hash"
    ]
  },
  "source_voltage_audit": {
    "enabled": true,
    "upper_warn_V": 4.25,
    "upper_fail_V": 4.35,
    "lower_warn_V": 2.45,
    "lower_fail_V": 2.35,
    "warn_if_any_warn": true,
    "warn_if_any_fail": true,
    "fail_if_fail_fraction_gt": 0.001,
    "fail_if_fail_count_gt": 10,
    "note": "Audits voltage_exp source data. A single isolated source spike becomes WARN, not hard FAIL."
  },
  "boundaries": {
    "does_train": false,
    "modifies_gv1_mainline": false,
    "generates_soh": false,
    "generates_full_p2d_truth": false
