    {"batch": "Batch-2", "battery": "battery-8", "reason": "middle representative of Batch-2 3C charge / 1C full-discharge stress-test"},
    {"batch": "Batch-3", "battery": "battery-6", "reason": "R2.5 variable full-discharge representative from D14/D15 8-cell set"},
    {"batch": "Batch-4", "battery": "battery-7", "reason": "R3 partial-discharge representative; used in D14 3D radial-gradient diagnosis"},
    {"batch": "Batch-5", "battery": "battery-7", "reason": "random-walk representative from D14/D15 8-cell set"},
    {"batch": "Batch-6", "battery": "battery-3", "reason": "GEO representative from D14/D15 8-cell set; difficult sparse-spike case"}
