  "default_paths": {
    "p5b_output_dir": "E:/XJTU battery dataset/_gv1_cache/xjtu_d14_p5b_8cell_closedset_precision_v2",
    "output_dir": "E:/XJTU battery dataset/_gv1_cache/xjtu_d14_p5c_8cell_closedset_precision_audit"
  },
  "required_inputs": {
    "training_summary": "ModelFin_D14_P5B_8cell_closedset_precision/training_summary.json",
    "loss_history": "ModelFin_D14_P5B_8cell_closedset_precision/loss_history.csv",
    "eval_report": "EvalFin_D14_P5B_8cell_closedset_precision/D14_P5B_EVAL_REPORT.json",
    "metrics_by_profile": "EvalFin_D14_P5B_8cell_closedset_precision/metrics_by_profile.csv",
    "metrics_global": "EvalFin_D14_P5B_8cell_closedset_precision/metrics_global.json",
    "verify_report": "D14_P5B_VERIFY_REPORT.json"
  },
  "precision_thresholds": {
    "mean_phis_c_mae_pass_V": 0.01,
    "max_phis_c_mae_pass_V": 0.015,
    "mean_phie_mae_pass": 0.01,
    "max_phie_mae_pass": 0.015,
    "mean_theta_mean_mae_pass": 0.01,
    "max_theta_mean_mae_pass": 0.015,
    "mean_theta_a_mae_pass": 0.01,
    "mean_theta_c_mae_pass": 0.01,
    "min_phis_c_corr_pass": 0.999,
    "min_theta_corr_pass": 0.999,
    "profile_count_required": 8,
