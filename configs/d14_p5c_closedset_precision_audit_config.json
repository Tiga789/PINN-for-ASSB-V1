  "target_batteries": [
    "Batch-1 / 2C / battery-1",
    "Batch-1 / 2C / battery-3",
    "Batch-3 / R2.5 / battery-6",
    "Batch-3 / R2.5 / battery-7",
    "Batch-4 / R3 / battery-2",
    "Batch-4 / R3 / battery-7",
    "Batch-5 / random_walk / battery-7",
    "Batch-6 / GEO / battery-3"
  ],
  "boundaries": {
    "closed_set_calibration": true,
    "not_generalization_claim": true,
    "does_not_train": true,
    "does_not_generate_softlabels": true,
    "does_not_generate_soh": true,
    "does_not_modify_gv1_mainline": true,
