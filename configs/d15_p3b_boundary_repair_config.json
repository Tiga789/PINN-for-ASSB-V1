{
  "stage": "D15-P3B",
  "name": "xjtu_batch2_boundary_projection_repair",
  "description": "Batch-2 3-cell NN boundary/projection repair. It does not regenerate P2Dlite-RG soft labels and does not retrain the NN; it evaluates raw NN predictions and an inference-time theta projection on full profiles.",
  "default_paths": {
    "cache_root_windows": "E:/XJTU battery dataset/_gv1_cache",
    "softlabel_dir": "E:/XJTU battery dataset/_gv1_cache/xjtu_softlabels_p2dlite_rg_v1_d15p3_batch2_3cell",
    "model_dir": "E:/XJTU battery dataset/_gv1_cache/xjtu_d15_p3_batch2_3cell_rg_nn_smoke",
    "output_root": "E:/XJTU battery dataset/_gv1_cache/xjtu_d15_p3b_batch2_boundary_projection_repair",
    "review_zip": "E:/XJTU battery dataset/_gv1_cache/xjtu_d15_p3b_results_for_review.zip"
  },
  "data": {
    "filename": "solution_softlabels.npz",
    "expected_profile_count": 3,
    "eval_stride": 1
  },
  "inference": {
    "device": "auto",
    "batch_size": 262144,
    "quick_batch_size": 65536,
    "quick_eval_stride": 8,
    "save_prediction_npz": false
  },
  "projection": {
    "mode": "eps_clip",
    "theta_min": 0.0001,
    "theta_max": 0.9999,
    "apply_to": ["theta_a", "theta_c"],
    "keep_potentials_raw": true
  },
  "scorecard_thresholds": {
    "smoke_global_phis_c_mae_max_v": 0.035,
    "smoke_global_phie_mae_max_v": 0.050,
    "smoke_global_theta_a_mae_max": 0.040,
    "smoke_global_theta_c_mae_max": 0.040,
    "smoke_global_theta_a_mean_mae_max": 0.025,
    "smoke_global_theta_c_mean_mae_max": 0.025,
    "smoke_global_grad_a_mae_max": 0.045,
    "smoke_global_grad_c_mae_max": 0.045,
    "smoke_global_min_corr": 0.970,
    "pred_theta_outside_fraction_max": 0.010,
    "pred_theta_boundary_hit_fraction_max": 0.150,
    "projected_theta_outside_fraction_target": 0.001,
    "allowed_theta_mae_relative_worsening": 0.15,
    "allowed_gradient_mae_relative_worsening": 0.20,
    "allowed_absolute_mae_worsening": 0.002
  },
  "audit_notes": [
    "D15-P3B fixes only NN prediction boundary behavior for Batch-2 3-cell smoke; it does not change Batch-2 P2Dlite-RG soft labels.",
    "Raw predictions and projected predictions are both reported. Any scientific claim should mention the projection explicitly.",
    "This is still closed-set Batch-2 3-cell verification, not Batch-2 15-cell benchmark and not held-out generalization."
  ]
}
