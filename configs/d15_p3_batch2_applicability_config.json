{
  "stage": "D15-P3",
  "name": "xjtu_batch2_p2dlite_rg_applicability_validation",
  "description": "Batch-2 extension package: raw data/replay audit, 3-cell representative P2Dlite-RG soft-label generation, and optional closed-set NN smoke. Batch-2 is treated as a 3C charge / 1C discharge applicability stress test, not a held-out proof.",
  "default_paths": {
    "raw_root_windows": "E:/XJTU battery dataset",
    "cache_root_windows": "E:/XJTU battery dataset/_gv1_cache",
    "batch2_replay_dir": "E:/XJTU battery dataset/_gv1_cache/xjtu_batch2_replay_profiles_d15p3",
    "batch2_softlabels_3cell_dir": "E:/XJTU battery dataset/_gv1_cache/xjtu_softlabels_p2dlite_rg_v1_d15p3_batch2_3cell",
    "batch2_radial_audit_dir": "E:/XJTU battery dataset/_gv1_cache/xjtu_d15_p3_batch2_3cell_radial_audit",
    "batch2_nn_smoke_dir": "E:/XJTU battery dataset/_gv1_cache/xjtu_d15_p3_batch2_3cell_rg_nn_smoke",
    "batch2_scorecard_dir": "E:/XJTU battery dataset/_gv1_cache/xjtu_d15_p3_batch2_applicability_scorecard",
    "review_zip": "E:/XJTU battery dataset/_gv1_cache/xjtu_d15_p3_results_for_review.zip"
  },
  "batch2": {
    "expected_batch": "Batch-2",
    "expected_profile_count_full": 15,
    "representative_battery_ids_preferred": [1, 8, 15],
    "fallback_representative_strategy": "first_middle_last_sorted_by_battery_id",
    "expected_protocol": "3C_charge_1C_discharge_fixed_full_depth",
    "nominal_capacity_Ah": 2.0,
    "voltage_min_V": 2.5,
    "voltage_max_V": 4.2,
    "sampling_Hz": 1.0,
    "positive_current_means": "charge"
  },
  "raw_reader": {
    "candidate_batch_dir_names": ["Batch-2", "Batch2", "batch-2", "batch2", "Batch_2"],
    "mat_glob": "*.mat",
    "min_time_points_per_profile": 1000,
    "current_rest_abs_A_threshold": 0.05,
    "auto_flip_current_to_positive_charge": true,
    "temperature_fallback_C": 25.0,
    "max_cells_to_build": 15
  },
  "p2dlite_rg_generation": {
    "prior_json": "configs/P2Dlite_prior_xjtu_lr18650la_rg_v1.json",
    "n_r": 17,
    "theta_positive_initial": 0.90,
    "theta_negative_initial": 0.08,
    "capacity_scale_Ah": 2.0,
    "phie_ohmic_scale_V_per_A": -0.015,
    "preserve_voltage_exp_as_phis_c_soft": true,
    "important_boundary": "Batch-2 labels generated by D15-P3 are provisional model-consistent RG soft labels. They are for applicability testing, not experimental internal-state truth."
  },
  "applicability_thresholds": {
    "replay_profile_count_min": 3,
    "representative_count_required": 3,
    "rg_generation_error_count_max": 0,
    "radial_audit_fail_count_max": 0,
    "theta_outside_fraction_review_max": 0.01,
    "nn_smoke_final_status_allowed": ["PASS", "REVIEW"]
  },
  "notes": [
    "D15-P3 should not overwrite D15-P0/P1/P2 or P4B/P5B/P5C outputs.",
    "Batch-2 is not a new random discharge protocol; it is mainly a 3C high-charge stress test relative to Batch-1 2C.",
    "If direct .mat parsing fails for Batch-2, upload the preflight/discovery report before modifying generator physics."
  ]
}
